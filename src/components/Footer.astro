---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-name">ML Partners, LLC</div>
        <p class="footer-tag">
          Proprietary energy trading. Certified MISO market participant since 2008.
        </p>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href="/#desk">Desk</a>
        <a href="/#edge">Edge</a>
        <a href="/#footprint">Footprint</a>
        <a href="/#record">Record</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
    <div class="footer-base mono">
      <span>&copy; {currentYear} ML Partners, LLC</span>
      <span class="footer-note">Map visualization is stylized &amp; illustrative — not live grid data</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--night-2);
    padding: 3.5rem 0 2rem;
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .footer-name {
    font-variation-settings: 'wdth' 120;
    font-weight: 800;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }

  .footer-tag {
    color: var(--muted);
    font-size: 0.85rem;
    max-width: 340px;
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 1.6rem;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.25s ease;
  }

  .footer-links a:hover { color: var(--amber); }

  .footer-base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--line-soft);
    padding-top: 1.5rem;
    color: var(--muted);
    font-size: 0.64rem;
  }

  .footer-note { opacity: 0.7; }
</style>
