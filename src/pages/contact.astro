---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contact — ML Partners, LLC"
  description="Reach the ML Partners trading desk. Proprietary energy trading firm — MISO market participant since 2008."
>
  <Navbar />

  <section class="contact-hero">
    <div class="wrap">
      <p class="eyebrow">/ Contact</p>
      <h1 class="contact-title display-xl">Reach<br />the desk.</h1>
      <p class="contact-sub">
        ML Partners is a proprietary trading firm — we don't take clients or
        manage outside capital. For counterparty matters, market questions, or
        anything else, send a message below.
      </p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap form-wrap">
      <form id="contactForm" class="panel contact-form reveal" novalidate>
        <div class="panel-index">/ Message the Desk</div>

        <div class="form-row">
          <div class="field">
            <label for="cf-name" class="mono">Name</label>
            <input id="cf-name" name="name" type="text" maxlength="100" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="cf-email" class="mono">Email</label>
            <input id="cf-email" name="email" type="email" maxlength="200" required autocomplete="email" />
          </div>
        </div>

        <div class="field">
          <label for="cf-message" class="mono">Message</label>
          <textarea id="cf-message" name="message" rows="7" maxlength="5000" required></textarea>
        </div>

        <!-- Honeypot — humans never see this -->
        <div class="field hp" aria-hidden="true">
          <label for="cf-website">Website</label>
          <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-foot">
          <button type="submit" class="btn btn-solid" id="cf-submit">Send Message</button>
          <p class="form-status mono" id="cf-status" role="status"></p>
        </div>
      </form>

      <div class="panel contact-sent" id="contactSent" hidden>
        <div class="panel-index">/ Transmitted</div>
        <h2 class="sent-title">Message received.</h2>
        <p>Your message is on its way to the desk — typically answered within 24 hours.</p>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .contact-hero {
    position: relative;
    padding: 11rem 0 5rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 60% at 75% 20%, rgba(255, 180, 84, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse 60% 70% at 20% 80%, rgba(30, 52, 90, 0.5) 0%, transparent 65%),
      radial-gradient(rgba(233, 228, 216, 0.1) 1px, transparent 1.5px);
    background-size: auto, auto, 28px 28px;
  }

  .contact-title {
    font-size: clamp(2.6rem, 6.5vw, 5rem);
    margin: 1.4rem 0 1.8rem;
  }

  .contact-sub {
    max-width: 540px;
    color: var(--muted);
    font-size: 1.02rem;
    margin: 0;
  }

  .form-wrap { max-width: 880px; }

  .contact-form { padding: 2.4rem 2.2rem 2.2rem; }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }

  .field { margin-bottom: 1.5rem; }

  .field label {
    display: block;
    color: var(--muted);
    margin-bottom: 0.55rem;
  }

  .field input,
  .field textarea {
    width: 100%;
    background: rgba(5, 9, 16, 0.6);
    border: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--display);
    font-size: 0.98rem;
    padding: 0.85rem 1rem;
    border-radius: 0;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--amber);
    box-shadow: 0 0 0 1px var(--amber), 0 0 24px rgba(255, 180, 84, 0.15);
  }

  /* Honeypot: visually removed, still in the DOM for bots */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-foot {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: wrap;
  }

  .btn[disabled] {
    opacity: 0.55;
    pointer-events: none;
  }

  .form-status {
    margin: 0;
    color: var(--muted);
  }

  .form-status.error { color: #ff7e6b; }

  .contact-sent { padding: 3rem 2.2rem; }

  .sent-title {
    font-variation-settings: 'wdth' 118;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.6rem;
    margin-bottom: 0.8rem;
    color: var(--amber);
  }

  .contact-sent p {
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 640px) {
    .form-row { grid-template-columns: 1fr; gap: 0; }
    .contact-hero { padding-top: 8.5rem; }
  }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const status = document.getElementById('cf-status')!;
  const submit = document.getElementById('cf-submit') as HTMLButtonElement;
  const sent = document.getElementById('contactSent')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = '';
    status.classList.remove('error');

    const data = {
      name: (form.elements.namedItem('name') as HTMLInputElement).value.trim(),
      email: (form.elements.namedItem('email') as HTMLInputElement).value.trim(),
      message: (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim(),
      website: (form.elements.namedItem('website') as HTMLInputElement).value,
    };

    if (data.name.length < 2 || !/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(data.email) || data.message.length < 10) {
      status.textContent = 'Please fill in name, a valid email, and a message (10+ characters).';
      status.classList.add('error');
      return;
    }

    submit.disabled = true;
    status.textContent = 'Transmitting…';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const body = await res.json().catch(() => ({ ok: false }));
      if (res.ok && body.ok) {
        form.hidden = true;
        sent.hidden = false;
        sent.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        status.textContent = body.error || 'Could not send right now — please try again later.';
        status.classList.add('error');
        submit.disabled = false;
      }
    } catch {
      status.textContent = 'Network error — please try again.';
      status.classList.add('error');
      submit.disabled = false;
    }
  });
</script>
