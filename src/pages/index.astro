---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import NightGrid from '../components/NightGrid.astro';

const heroStats = [
  { value: "2008", label: "MISO Participant Since" },
  { value: "2,546", label: "Pricing Nodes Tracked" },
  { value: "59M+", label: "Price Records" },
  { value: "623K", label: "Transmission Graph Edges" },
];

const deskPanels = [
  {
    index: "01",
    title: "Virtual Trading",
    body: "Increment offers and decrement bids across the MISO footprint — positions on the spread between day-ahead and real-time prices, placed where the models see the grid mispriced.",
  },
  {
    index: "02",
    title: "Price Forecasting",
    body: "An in-house LSTM network — 359,000 parameters trained on 59 million nodal price records — sits behind every position the desk takes.",
  },
  {
    index: "03",
    title: "Congestion Analytics",
    body: "The transmission system as a graph: 2,546 vertices, 623,000 edges. When a constraint binds, congestion ripples outward — we map where it lands before it gets there.",
  },
];

const edgeStats = [
  { value: "70×", label: "ETL Acceleration" },
  { value: "264", label: "Automated Tests" },
  { value: "99.9%", label: "System Uptime" },
  { value: "359K", label: "Model Parameters" },
];

const footprintStats = [
  { value: "15", label: "U.S. States + Manitoba" },
  { value: "45M", label: "People Served" },
  { value: "65K+", label: "Miles of Transmission" },
  { value: "127GW", label: "Peak Demand Record" },
];

const registry = [
  { key: "Entity", val: "ML Partners, LLC" },
  { key: "Origin", val: "ML Partnership LLC" },
  { key: "Status", val: "Certified MISO Market Participant" },
  { key: "Since", val: "2008" },
  { key: "Regulatory Record", val: "Clean" },
  { key: "Capital", val: "Proprietary — no clients, no outside money" },
];

const tickerItems = [
  ["MINN.HUB", "DA ⇄ RT"],
  ["ILLINOIS.HUB", "LMP · MCC · MLC"],
  ["MICH.HUB", "EX-ANTE / EX-POST"],
  ["INDIANA.HUB", "VIRTUALS"],
  ["ARKANSAS.HUB", "DA ⇄ RT"],
  ["MS.HUB", "NODAL"],
  ["LOUISIANA.HUB", "CONGESTION"],
  ["TEXAS.HUB", "DA ⇄ RT"],
];
---

<BaseLayout>
  <Navbar />

  <!-- ============ HERO ============ -->
  <section class="hero">
    <NightGrid />
    <div class="wrap hero-content">
      <p class="eyebrow hero-eyebrow">ML Partners, LLC · Proprietary Energy Trading</p>
      <h1 class="hero-title display-xl">
        Every light<br />is a node.<br />
        <span class="hero-accent">Every node<br />is a price.</span>
      </h1>
      <p class="hero-sub">
        A proprietary trading firm in MISO's wholesale power markets — certified
        market participant since 2008. We trade day-ahead against real-time across
        2,546 pricing nodes, guided by machine-learning models built and trained in-house.
      </p>
      <div class="hero-cta">
        <a href="#desk" class="btn btn-solid">How We Trade</a>
        <a href="/contact" class="btn btn-ghost">Contact the Desk</a>
      </div>
    </div>

    <div class="hero-stats">
      <div class="wrap hero-stats-row">
        {heroStats.map(s => (
          <div class="hero-stat">
            <div class="hero-stat-value">{s.value}</div>
            <div class="hero-stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ TICKER ============ -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[0, 1].map(() => (
        tickerItems.map(([hub, tag]) => (
          <span><b>{hub}</b> · {tag}</span>
        ))
      ))}
    </div>
  </div>

  <!-- ============ 01 THE DESK ============ -->
  <section id="desk" class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-index">/ 01</span>
        <h2 class="sec-title">The Desk</h2>
        <span class="sec-rule"></span>
      </div>
      <p class="lede reveal">
        No clients. No fund. No services for sale. ML Partners trades its own book
        in MISO's wholesale electricity markets — and has since 2008.
      </p>
      <div class="desk-grid">
        {deskPanels.map((p, i) => (
          <div class={`panel reveal reveal-d${i + 1}`}>
            <div class="panel-index">/ {p.index}</div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 02 THE EDGE ============ -->
  <section id="edge" class="sec sec-alt">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-index">/ 02</span>
        <h2 class="sec-title">The Edge</h2>
        <span class="sec-rule"></span>
      </div>
      <div class="edge-grid">
        <div class="reveal">
          <p class="lede">
            Everything from data ingestion to order placement runs on
            infrastructure written in-house.
          </p>
        </div>
        <div class="edge-stats reveal reveal-d1">
          {edgeStats.map(s => (
            <div class="edge-stat">
              <div class="stat-value">{s.value}</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 03 THE FOOTPRINT ============ -->
  <section id="footprint" class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-index">/ 03</span>
        <h2 class="sec-title">The Footprint</h2>
        <span class="sec-rule"></span>
      </div>
      <p class="lede reveal">
        MISO — the Midcontinent Independent System Operator — runs the wholesale
        power market for the middle of America, from the Canadian border to the
        Gulf of Mexico. That map of lights is where we work. Coverage extends to
        the neighboring Southwest Power Pool.
      </p>
      <div class="footprint-grid reveal reveal-d1">
        {footprintStats.map(s => (
          <div class="footprint-stat">
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 04 THE RECORD ============ -->
  <section id="record" class="sec sec-alt">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-index">/ 04</span>
        <h2 class="sec-title">The Record</h2>
        <span class="sec-rule"></span>
      </div>
      <div class="record-grid">
        <div class="reveal">
          <p class="lede">
            Eighteen years in the market. One clean regulatory record.
          </p>
          <p class="edge-copy">
            Originally chartered as ML Partnership LLC, the firm has held
            continuous MISO market certification since 2008 — through the polar
            vortex, through Winter Storm Uri, through every shape the market has
            thrown at it. We answer to our own capital and nobody else's.
          </p>
        </div>
        <dl class="registry panel reveal reveal-d1">
          {registry.map(r => (
            <div class="registry-row">
              <dt>{r.key}</dt>
              <dd>{r.val}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ 05 CONTACT ============ -->
  <section id="contact" class="sec">
    <div class="wrap contact-wrap">
      <div class="sec-head reveal">
        <span class="sec-index">/ 05</span>
        <h2 class="sec-title">Contact</h2>
        <span class="sec-rule"></span>
      </div>
      <div class="contact-box reveal">
        <p class="lede">
          We don't take clients or outside capital — but if you're a market
          participant, counterparty, or data provider, the inbox is open.
        </p>
        <a href="/contact" class="btn btn-solid">Message the Desk</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: 7rem;
    padding-bottom: 3rem;
  }

  .hero-eyebrow {
    margin-bottom: 1.6rem;
    animation: rise 0.8s cubic-bezier(0.2, 0.6, 0.2, 1) both 0.1s;
  }

  .hero-title {
    font-size: clamp(2.6rem, 7.2vw, 6rem);
    animation: rise 0.9s cubic-bezier(0.2, 0.6, 0.2, 1) both 0.25s;
  }

  .hero-accent {
    color: var(--amber);
    text-shadow: 0 0 48px rgba(255, 180, 84, 0.4);
  }

  .hero-sub {
    max-width: 560px;
    color: var(--muted);
    font-size: 1.02rem;
    margin: 1.8rem 0 2.2rem;
    animation: rise 0.9s cubic-bezier(0.2, 0.6, 0.2, 1) both 0.45s;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    animation: rise 0.9s cubic-bezier(0.2, 0.6, 0.2, 1) both 0.6s;
  }

  .hero-stats {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line);
    background: rgba(5, 9, 16, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fade 1s ease both 0.85s;
  }

  .hero-stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .hero-stat {
    padding: 1.3rem 1.2rem;
    border-left: 1px solid var(--line);
  }

  .hero-stat:last-child { border-right: 1px solid var(--line); }

  .hero-stat-value {
    font-variation-settings: 'wdth' 116;
    font-weight: 820;
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    color: var(--amber);
    line-height: 1;
  }

  .hero-stat-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.45rem;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* ---- Shared section bits ---- */
  .lede {
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    font-weight: 460;
    line-height: 1.45;
    max-width: 760px;
    margin-bottom: 2.8rem;
    color: var(--ink);
  }

  .edge-copy {
    color: var(--muted);
    font-size: 0.97rem;
    max-width: 560px;
  }

  /* ---- Desk ---- */
  .desk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* ---- Edge ---- */
  .edge-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .edge-grid .lede { margin-bottom: 1.4rem; }

  .edge-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .edge-stat {
    border: 1px solid var(--line);
    margin: 0 -1px -1px 0;
    padding: 1.8rem 1.5rem;
  }

  /* ---- Footprint ---- */
  .footprint-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
  }

  .footprint-stat {
    padding: 2.2rem 1.6rem;
    border-left: 1px solid var(--line);
  }

  .footprint-stat:first-child { border-left: none; }

  /* ---- Record ---- */
  .record-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .record-grid .lede { margin-bottom: 1.4rem; }

  .registry {
    margin: 0;
    padding: 0.6rem 1.75rem;
  }

  .registry-row {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 1rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .registry-row:last-child { border-bottom: none; }

  .registry dt {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.2rem;
  }

  .registry dd {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink);
  }

  /* ---- Contact ---- */
  .contact-box {
    text-align: left;
  }

  .contact-box .lede { margin-bottom: 2rem; }

  /* ---- Responsive ---- */
  @media (max-width: 960px) {
    .desk-grid { grid-template-columns: 1fr; }
    .edge-grid, .record-grid { grid-template-columns: 1fr; }
    .footprint-grid { grid-template-columns: 1fr 1fr; }
    .footprint-stat { border-top: 1px solid var(--line); }
    .footprint-stat:nth-child(-n+2) { border-top: none; }
    .footprint-stat:nth-child(odd) { border-left: none; }
  }

  @media (max-width: 640px) {
    .hero-stats-row { grid-template-columns: 1fr 1fr; }
    .hero-stat:nth-child(n+3) { border-top: 1px solid var(--line); }
    .hero-stat:nth-child(even) { border-right: 1px solid var(--line); }
    .registry-row { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
